/** BirthdayMealInvite Google Sheets backend. Paste into Extensions > Apps Script. */
const SHEET_NAME = 'Invitations';
const HEADERS = ['token','name','defaultCount','response','count','diet','note','updatedAt'];
function setup(){const ss=SpreadsheetApp.getActiveSpreadsheet();let sheet=ss.getSheetByName(SHEET_NAME);if(!sheet)sheet=ss.insertSheet(SHEET_NAME);if(sheet.getLastRow()===0)sheet.appendRow(HEADERS);if(!PropertiesService.getScriptProperties().getProperty('ADMIN_KEY')){const key=Utilities.getUuid()+'-'+Utilities.getUuid();PropertiesService.getScriptProperties().setProperty('ADMIN_KEY',key);console.log('SAVE YOUR HOST ACCESS CODE: '+key)}else console.log('Host access code already exists.');}
function doGet(e){let result;try{result=route_(e.parameter||{})}catch(err){result={ok:false,error:String(err.message||err)}}const callback=String((e.parameter||{}).callback||'');if(!/^cb_[a-z0-9]+$/.test(callback))return ContentService.createTextOutput(JSON.stringify({ok:false,error:'Invalid callback'})).setMimeType(ContentService.MimeType.JSON);return ContentService.createTextOutput(callback+'('+JSON.stringify(result)+');').setMimeType(ContentService.MimeType.JAVASCRIPT)}
function route_(p){const action=String(p.action||'');if(action==='guest')return getGuest_(p.token);if(action==='rsvp')return setRsvp_(p);if(action==='admin'||action==='add'){if(!p.key||p.key!==PropertiesService.getScriptProperties().getProperty('ADMIN_KEY'))throw Error('Invalid host access code');if(action==='admin')return {ok:true,guests:getRows_()};return addGuest_(p)}throw Error('Unknown action')}
function sheet_(){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);if(!s)throw Error('Run setup() first');return s}
function getRows_(){const s=sheet_();if(s.getLastRow()<2)return [];return s.getRange(2,1,s.getLastRow()-1,HEADERS.length).getValues().map((r,i)=>({row:i+2,token:String(r[0]),name:String(r[1]),defaultCount:Number(r[2])||1,response:String(r[3]),count:r[4]===''?null:Number(r[4]),diet:String(r[5]),note:String(r[6]),updatedAt:r[7]?String(r[7]):''}))}
function guest_(token){if(!/^[a-f0-9-]{36}$/.test(String(token||'')))throw Error('Invalid invitation link');const g=getRows_().find(r=>r.token===token);if(!g)throw Error('Invitation not found');return g}
function getGuest_(token){const g=guest_(token);return {ok:true,guest:{name:g.name,defaultCount:g.defaultCount,response:g.response,count:g.count,diet:g.diet,note:g.note}}}
function setRsvp_(p){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const g=guest_(p.token);const response=String(p.response||'');if(!['yes','maybe','no'].includes(response))throw Error('Invalid response');const count=Number(p.count);if(!Number.isInteger(count)||count<0||count>30)throw Error('Invalid party size');if(response==='no'&&count!==0)throw Error('Declined invitations must have zero attending');if(response==='yes'&&count<1)throw Error('Please enter the number attending');const diet=String(p.diet||'').slice(0,500),note=String(p.note||'').slice(0,500);sheet_().getRange(g.row,4,1,5).setValues([[response,count,safe_(diet),safe_(note),new Date().toISOString()]]);return {ok:true}}finally{lock.releaseLock()}}
function addGuest_(p){const name=String(p.name||'').trim().slice(0,100);const count=Number(p.count||1);if(!name||!Number.isInteger(count)||count<1||count>30)throw Error('Enter a guest name and valid party size');const token=Utilities.getUuid();sheet_().appendRow([token,safe_(name),count,'','','','', '']);return {ok:true,token}}
function safe_(v){return /^[=+@\-\t\r]/.test(v)?"'"+v:v}
